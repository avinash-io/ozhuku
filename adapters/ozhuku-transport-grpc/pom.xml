            <artifactId>ozhuku-transport-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.avinashio.ozhuku</groupId>
            <artifactId>ozhuku-foundation</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
